{
  "name": "microfrontends-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:shell": "npm run dev --workspace @mfe/shell",
    "dev:products": "npm run dev --workspace @mfe/products",
    "dev:cart": "npm run dev --workspace @mfe/cart",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@module-federation/vite": "^1.19.1",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
